<?xml version="1.0" encoding="UTF-8"?>
 
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
 
    <bean id="ProjectExport"
          class="com.salesforce.dataloader.process.ProcessRunner"
          singleton="false">
 
        <description>Export Project Records</description>
 
        <property name="name" value="ProjectExport"/>
 
        <property name="configOverrideMap">
            <map>
 
                <entry key="sfdc.endpoint"
                       value="https://login.salesforce.com"/>
 
                <entry key="sfdc.username"
                       value="prachi.patro.e02b8f7b3c70@agentforce.com"/>
 
                <entry key="sfdc.password"
                       value="*"/>
 
                <entry key="process.encryptionKeyFile"
                       value="C:\SalesforceProjectExport\project.key"/>
 
                <entry key="process.operation"
                       value="extract"/>
 
                <entry key="sfdc.entity"
                       value="Project__c"/>
 
                <entry key="sfdc.extractionSOQL"
                       value="SELECT Id, Name FROM Project__c"/>
 
                <entry key="dataAccess.type"
                       value="csvWrite"/>
 
                <entry key="dataAccess.name"
                       value="C:\SalesforceProjectExport\export\ProjectExport.csv"/>
 
            </map>
        </property>
 
    </bean>
 
</beans>
